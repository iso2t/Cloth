using cloth.collections.Snapshot : Snapshot, emptySnapshot;

typedef<struct> StackSlot<T> { pub T value; }

pub typedef<class> Stack<T>(def<StackSlot<T>[]> items) {
    pub Stack() : ([]) {}

    pub mt push(T value) = items.append({ value });

    pub mt<T> pop() {
        StackSlot<T> removed = items.removeAt(topIndex());
        return removed.value;
    }

    pub mt<T> peek() {
        usize index = topIndex();
        return items[index].value;
    }

    pub mt<usize> size() = items::size;

    pub mt<bool> isEmpty() = items::size == 0;

    pub mt clear() = items.clear();

    pub mt reserve(usize minimum) = items.reserve(minimum);

    pub operator foreach() -> Snapshot<T> {
        def snapshot = emptySnapshot<T>();
        usize index = items::size;
        while (index != 0) {
            index -= 1;
            snapshot.append(items[index].value);
        }
        return snapshot;
    }

    mt<usize> topIndex() {
        // On empty, let the ordinary checked access report the bounds error.
        if (items::size == 0) return 0;
        return items::size - 1;
    }
}
