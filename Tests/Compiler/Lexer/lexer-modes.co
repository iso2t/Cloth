// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

pub fn<bool> ready() = true;

// RUN: %expect_exit --empty-stdout --empty-stderr 0xD00001 %cloth -l --src "%/s"
// RUN: %expect_exit --empty-stderr 0xD00002 %cloth -L --src "%/s" > "%t.tokens"
// RUN: %filecheck "%/s" --input-file "%t.tokens"
// CHECK: "pub" Keyword 3:1-3:4
// CHECK: "bool" Keyword 3:8-3:12
// CHECK: "ready" Identifier 3:14-3:19

// RUN: echo 0b2 > "%t.invalid.co"
// RUN: %expect_exit --empty-stdout 1 %cloth -l --src "%t.invalid.co" 2> "%t.err"
// RUN: %filecheck "%/s" --check-prefix=ERROR --input-file "%t.err"
// RUN: %expect_exit --empty-stdout 1 %cloth -L --src "%t.invalid.co" 2> "%t.err"
// RUN: %filecheck "%/s" --check-prefix=ERROR --input-file "%t.err"
// ERROR: [C1013] Error: Invalid numeric literal '0b2'
