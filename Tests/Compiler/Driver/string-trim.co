// RUN: %cloth --stdlib %stdlib --kind executable --src "%s" --emit-object "%t.o"
// RUN: %llvm_readobj --symbols "%t.o" | %filecheck "%s" --check-prefix=OBJECT --implicit-check-not=cloth_rt_text_trim
// OBJECT: Symbols [
// RUN: %cc -I "%S/../../../Runtime/include" -DCLOTH_TEST_FORBID_ALLOCATIONS -include "%S/Inputs/growable-array-allocator.h" -c "%S/../../../Runtime/src/array.c" -o "%t.array.o"
// RUN: %cc "%t.o" "%t.array.o" %runtime -o "%t.exe"
// RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"

fn<bool> trims(string value, string both, string start, string end) =
    value.trim() == both && value.trimStart() == start && value.trimEnd() == end;

pub fn<int> main() {
    if (!trims("", "", "", "")) return 1;
    if (!trims("\t  \r\n", "", "", "")) return 2;

    string content = "é\0 \t😀";
    if (!trims(content, content, content, content)) return 3;
    string view = "x é\0 \t😀 y".substring(1, 8);
    if (!trims(view, content, "é\0 \t😀 ", " é\0 \t😀")) return 4;
    if (!trims("\t\0 ", "\0", "\0 ", "\t\0")) return 5;
    return 42;
}
