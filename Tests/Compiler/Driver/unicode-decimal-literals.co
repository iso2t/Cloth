pub fn<int> main() {
    if (!'𝟜'.isDigit() || '²'.isDigit()) return 1;
    if (٤٢ != 42 || 𝟿_𐒠i != 90) return 2;
    if (𝟘.𝟚5f != 0.25f) return 3;
    return 𝟜𝟚;
}

