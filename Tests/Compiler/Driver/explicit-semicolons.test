# A missing terminator has the same insertion point in a library entry and a transitive import.
# RUN: echo "pub typedef<class> Marker;" > "%t/Library.clib"
# RUN: echo "pub fn<int> read() = 42 // result" >> "%t/Library.clib"
# RUN: %expect_exit --empty-stdout 1 %cloth --src "%t/Library.clib" 2> "%t/direct.err"
# RUN: %filecheck "%s" --input-file "%t/direct.err"
# RUN: %expect_exit --empty-stdout 1 %cloth --src "%t/main.co" 2> "%t/import.err"
# RUN: %filecheck "%s" --input-file "%t/import.err"

