typedef<struct> Sample { pub bool ready, pub int<12> value; }

pub fn<int> main() {
    Sample sample = {true, 42};
    def original := sample;
    sample.value = 7;
    return if (sample.ready && original.value == 42) sample.value -> int else 1;
}
