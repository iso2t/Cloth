using cloth.Console : println;

pub fn<int> main() {
    int<65>[2] values = [7, 40];
    def saved := values;
    values[index()] += 2;
    if (values[0] != 7 || saved[1] != 40) return 1;
    return values[1] -> int;
}

fn<usize> index() {
    println(1);
    return 1;
}
