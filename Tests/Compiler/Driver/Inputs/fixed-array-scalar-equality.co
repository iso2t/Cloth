pub fn<int> main() {
    float[2] positive := [0.0, 7.0]
    float[2] negative = [-0.0, 7.0]
    if (positive != negative) return 1
    negative[1] = nan(0.0)
    return if (negative != negative && !(negative == negative)) 42 else 2
}

fn<float> nan(final float zero) = zero / zero
