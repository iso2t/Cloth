typedef<struct> Reading<T> { pub bool ready, pub T value }

pub fn<int> main() {
    Reading<int<12>> reading = {false, 42}
    def copy = reading
    reading.value = if (reading.ready) 0 else {
        reading.ready = trace(256)
        trace(7) -> int<12>
    }
    if (!reading.ready || reading.value != 7 || copy.ready || copy.value != 42) return 1

    copy.value += (if (reading.ready) {
        copy = {true, 99}
        5
    } else 0)
    if (!copy.ready || copy.value != 47) return 2
    reading = copy
    copy.value--
    reading.value++
    if (copy.value != 46 || reading.value != 48) return 3

    Reading<usize> sized = {true, usize::max}
    sized.value += 1
    sized.ready = trace(0)
    if (sized.ready || sized.value != 0) return 4
    if (writeOrReturn(true) != 42 || writeOrReturn(false) != 7) return 5
    return leaveThroughWrite()
}

fn<int> writeOrReturn(final bool early) {
    Reading<int<12>> reading = {true, 42}
    reading.value = if (early) { return reading.value -> int } else 7
    return reading.value -> int
}

fn<int> leaveThroughWrite() {
    Reading<int<12>> reading = {true, 42}
    reading.value = if (reading.ready) { return 7 } else { return 6 }
}

fn<int> trace(final int value) {
    println(value)
    return value
}
