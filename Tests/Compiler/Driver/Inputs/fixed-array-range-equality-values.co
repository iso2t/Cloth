fn<int> trace(final int label) {
    println(label)
    return label
}

fn<int> stopAtEnd(final bool stop) {
    if ([trace(6)..(if (stop) { return 42 } else 7)] == [trace(99)..7]) return 1
    return 2
}

pub fn<int> main() {
    def high := unsigned int<65>::max
    def low := high -> unsigned int<64> -> unsigned int<65>
    range<unsigned int<65>>?[2] wide = [null, high..=high]
    range<unsigned int<65>>?[2] saved := wide
    wide[1] = low..=high
    if (wide == saved || !(saved != wide)) return 1
    wide[1] = high..=low
    if (wide == saved || !(wide != saved)) return 2
    if (saved != [null, high..=high] || saved == [null, high..high]) return 3

    range<int>?[2] current = [0..0, null]
    range<int>?[2] before := current
    if (current == (if (trace(1) == 1) { current[1] = 0..0; current } else before)) return 4
    if (before != [0..0, null] || [0..0, 0..0] != current) return 5

    range<usize>?[0] empty := []
    if (empty != [] || !(empty == [])) return 6
    if ([trace(2)..trace(3)] == [trace(4)..trace(5), 0..0]) return 7
    return stopAtEnd(true)
}
