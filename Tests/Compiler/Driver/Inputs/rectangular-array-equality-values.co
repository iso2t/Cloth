using cloth.Console : println;

typedef<enum> Mode { pub Off, pub On; }

fn<int> trace(final int label) {
    println(label);
    return label;
}

fn<int> early(final bool stopOnLeft) {
    if ([[(if (stopOnLeft) { return 42; } else 7)]] == [[(if (!stopOnLeft) { return 42; } else 7), trace(99)]]) return 1;
    return 2;
}

pub fn<int> main() {
    if ([[trace(1)], [trace(2)]] == [[trace(3), trace(4)]]) return 1;

    int[0][3] empty := [];
    int[0][4] wider := [];
    int[2][0] emptyRows := [[], []];
    if (empty == wider || !(wider != empty) || emptyRows == empty) return 2;
    if (!(emptyRows == [[], []]) || [] != empty) return 3;
    if ((if (trace(5) == 5) empty else empty) != (if (trace(6) == 6) empty else empty)) return 4;

    int[2][2] rows = [[1, 2], [3, 4]];
    def saved := rows;
    if (rows == (if (trace(7) == 7) { rows[1][1] = 42; rows; } else saved)) return 5;
    if (rows != [[1, 2], [3, 42]] || saved != [[1, 2], [3, 4]]) return 6;

    usize[1][2][3] cube := [[[0, 1, 2], [3, 4, usize::max]]];
    usize[1][3][2] pairs := [[[0, 1], [2, 3], [4, usize::max]]];
    if (cube == pairs || !(pairs != cube) || cube != [[[0, 1, 2], [3, 4, usize::max]]]) return 7;

    int<17>?[2][1] optional = [[null], [0]];
    int<17>?[2][1] before := optional;
    optional[0][0] = 0;
    if (optional == before || before != [[null], [0]]) return 8;

    range<int>?[1][2] spans := [[null, 13..15]];
    if (spans != [[null, 13..15]] || spans == [[null, 13..=15]] || spans == [[0..0, 13..15]]) return 9;
    float[1][1] zeros := [[0.0]];
    float[1][1] withNaN := [[nan(0.0)]];
    if (zeros != [[-0.0]] || withNaN == withNaN) return 10;

    bool[1][2] flags := [[0, -7]];
    char[2][1] letters := [['\0'], ['A']];
    Mode[1][2] modes := [[Mode.Off, Mode.On]];
    if (flags != [[false, true]] || letters == [['\0'], ['B']] || modes == [[Mode.On, Mode.Off]]) return 11;

    if (early(true) != 42) return 12;
    return early(false);
}

fn<float> nan(final float zero) = zero / zero;
