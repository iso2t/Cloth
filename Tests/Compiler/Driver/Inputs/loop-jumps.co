pub fn<int> main() {
    return if (guardedWhile() != 85) 1
        else if (postTest() != 32) 2
        else if (nestedBodies() != 16) 3
        else if (breakFromTrailer() != 12) 4
        else if (continueFromHeader() != 33) 5
        else if (skipTrailer(0) != 7) 6
        else if (logicalJumps(true, false) != 100 || logicalJumps(false, true) != 101 || logicalJumps(false, false) != 11) 7
        else if (guaranteedJump(true) != 1 || guaranteedJump(false) != 3) 8
        else 42
}

fn<int> guardedWhile() {
    int n = 0
    int total = 0
    int tests = 0
    while (if (true) { tests++; n < 10 } else false) {
        n++
        if (n == 2) continue
        if (n == 5) break
        total += n
    }
    return total * 10 + tests
}

fn<int> postTest() {
    int n = 0
    int tests = 0
    do {
        n++
        if (n == 3) break
        continue
    } while (if (true) { tests++; n < 6 } else false)
    return n * 10 + tests
}

fn<int> nestedBodies() {
    int rows = 0
    int total = 0
    while (rows < 5) {
        rows++
        int column = 0
        do {
            column++
            if (column == 1) continue
            if (column == 3) break
            total += rows
        } while (column < 6)
        if (rows == 2) continue
        if (rows == 3) break
        total += 10
    }
    return total
}

fn<int> breakFromTrailer() {
    int rows = 0
    int total = 0
    while (rows < 5) {
        rows++
        do continue while (if (rows == 2) { break } else false)
        total += 10
    }
    return total + rows
}

fn<int> continueFromHeader() {
    int rows = 0
    int tests = 0
    do {
        rows++
        while (if (true) { continue } else false) { return 99 }
    } while (if (true) { tests++; rows < 3 } else false)
    return rows * 10 + tests
}

fn<int> skipTrailer(final int divisor) {
    do break while (1 / divisor > 0)
    return 7
}

fn<int> logicalJumps(final bool stop, final bool skip) {
    int total = 0
    int effects = 0
    do {
        bool first := stop && (if (true) { effects++; break } else true)
        total++
        bool second := !skip || (if (true) { effects++; continue } else false)
        total += 10
    } while (false)
    return total + 100 * effects
}

fn<int> guaranteedJump(final bool leave) {
    int visits = 0
    do {
        visits++
        bool result := true && ((if (leave) { break } else { continue }) || false)
    } while (visits < 3)
    return visits
}
