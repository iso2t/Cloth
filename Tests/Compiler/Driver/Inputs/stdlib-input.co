using cloth.Console : print, println, input;

fn<int> runtimeInt(int value) = value;
fn<usize> runtimeIndex(usize value) = value;
fn<float<64>> zero() = 0.0;
fn<usize> width(typeinfo value) = value::width;
fn<int> magnitude(int<8> value) = value.abs() -> int;
fn<int> sign(float<64> value) = value.signum();

pub fn<int> main(string[] args) {
    if (args::size != 0) {
        if (args[0] == "abs") return magnitude(-128);
        if (args[0] == "clamp") return 1.clamp(runtimeInt(4), 2);
        if (args[0] == "nan") return sign(0.0 / zero());
        if (args[0] == "radix") return 42.toStringRadix(runtimeInt(1))::size -> int;
        if (args[0] == "index") return "é".charAt(runtimeIndex(1)).toInt();
        if (args[0] == "metadata") return width(string::type) -> int;
        if (args[0] == "invalid") return if (input() == null) 42 else 1;
    }
    print("input");
    string? line = input("> ");
    if (line != "é😀") return 1;
    string? blank = input(null);
    if (blank != "" || input() != null) return 2;
    println();
    return 42;
}
