fn<int[][]> appendCopy(int[][] rows) {
    rows.reserve(8);
    rows.append(rows[0]);
    rows[0][0] = 8;
    return rows;
}

fn<int[]> makeRow(int n) = [n, n + 1];

pub fn<int> main() {
    int[][] rows = [[1, 2], [3, 42]];
    int[][] saved = rows;
    rows[1][1] = 7;
    saved[0][0] += 9;
    if (rows[0][0] != 1 || rows[1][1] != 7 || saved[0][0] != 10) return 1;
    int[] row = saved[1];
    row[1] = 0;
    rows = [[5, 6]];
    if (rows::size != 1 || saved::size != 2 || rows[0][1] != 6) return 2;

    def grown := appendCopy(rows);
    if (grown != [[8, 6], [5, 6]] || rows != [[5, 6]]) return 3;
    rows.insert(0, makeRow(2));
    rows[0].reserve(12);
    rows[1] = rows[0];
    rows[0][0]++;
    int[] removed = rows.removeAt(1);
    if (removed != [2, 3] || rows[0][0] != 3) return 4;
    rows.clear();
    rows.append(removed);
    if (rows != [[2, 3]]) return 5;

    int[][] emptyRows = [[], []];
    emptyRows.append([]);
    if (emptyRows::size != 3 || emptyRows[2]::size != 0) return 6;
    int[][][] cube = [[[1, 2]], [[3, 4]]];
    def original := cube;
    cube[1][0][0] = 11;
    if (original[1][0][0] != 3 || cube[1][0][0] != 11) return 7;

    int[1][2] fixed := rows;
    int[][2] fixedWidth = fixed;
    int[1][] fixedHeight = fixedWidth;
    if (fixedHeight[0][1] != 3 || fixedWidth[0] != [2, 3]) return 8;
    int[][] dynamicRows = [makeRow(4), makeRow(7)];
    int sum = 0;
    for (int[] each <- dynamicRows) {
        sum += each[0];
        each[0] = 0;
    }
    if (sum != 11 || dynamicRows[1][0] != 7) return 9;
    dynamicRows[1][0] += (if (true) { dynamicRows = [[10, 11], [12, 13]]; 1; } else 0);
    if (dynamicRows[1][0] != 8 || dynamicRows[0][1] != 11) return 10;
    int captured := dynamicRows[if (true) { dynamicRows = [[20, 21]]; 0; } else 0][1];
    if (captured != 11 || dynamicRows[0][1] != 21) return 11;

    int?[][] optional = [[null, 2]];
    int?[][] savedOptional := optional;
    optional[0][0] = 9;
    if (savedOptional[0][0] != null || (optional[0][0] ?: 0) != 9) return 12;
    int[][]? present = saved;
    if (present == null || present[1][1] != 42) return 13;
    present = null;
    if (present != null) return 14;
    return saved[1][1];
}
