pub fn<int> main() {
    int[] values = [7, 9]
    values.insert(1, 42)
    if (values::size != 3 || values[0] != 7 || values[1] != 42 || values[2] != 9) return 1

    int removed := values.removeAt(1)
    if (values::size != 2 || values[0] != 7 || values[1] != 9) return 2
    values.clear()
    if (values::size != 0) return 3

    values.append(removed)
    return values[0]
}
