// RUN: %cloth --stdlib %stdlib --kind executable --src "%s" --emit-object "%t.o"
// RUN: %cc "%t.o" %runtime -o "%t.exe"
// RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"

using cloth.collections.Stack : Stack;

pub fn<int> main() {
    def stack = Stack<int>::new;
    for (int item <- stack) return 1;
    for (int item <- 1..=3) stack.push(item);

    int[] seen = [];
    for (int item <- stack) {
        if (seen::size == 0) {
            if (stack.size() != 3 || stack.pop() != 3) return 2;
            stack.clear();
            stack.push(4);
            stack.push(5);
        }
        seen.append(item);
    }
    if (seen != [3, 2, 1]) return 3;
    seen.clear();
    for (int item <- stack) seen.append(item);
    if (seen != [5, 4] || stack.size() != 2 || stack.pop() != 5 || stack.pop() != 4) return 4;
    stack::delete;

    def rows = Stack<int[]>::new;
    rows.push([1]);
    rows.push([2, 3]);
    seen.clear();
    for (int[] row <- rows) {
        seen.append(row[0]);
        row[0] = 0;
    }
    if (seen != [2, 1] || rows.pop() != [2, 3] || rows.pop() != [1]) return 5;
    rows::delete;
    return 42;
}
