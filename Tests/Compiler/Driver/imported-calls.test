# OBJ32: AddressSize: 32bit
# OBJ64: AddressSize: 64bit
# ENTRY-win32: Name: {{_?}}main{{$}}
# ENTRY-linux: Name: main (
# ENTRY-NOT: }
# ENTRY-linux: Binding: Global
# ENTRY-linux-NOT: }
# ENTRY: Section: .text (
# ENTRY-win32-NOT: }
# ENTRY-win32: StorageClass: External
# HELPER-win32: Name: {{_?}}cloth.identity{{$}}
# HELPER-linux: Name: cloth.identity (
# HELPER-NOT: }
# HELPER-linux: Binding: Local
# HELPER-linux-NOT: }
# HELPER: Section: .text (
# HELPER-win32-NOT: }
# HELPER-win32: StorageClass: Static

