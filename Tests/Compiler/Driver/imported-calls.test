# Each file calls its own private pick. Selecting the first parameter twice
# would return 7, and selecting the last twice would return 19.
# RUN: echo "using helpers: selectLast;" > "%t.dir/main.co"
# RUN: echo "pub fn<int> main() = pick(selectLast(7, selectLast(23)), 19);" >> "%t.dir/main.co"
# RUN: echo "fn<int> pick(int first, int last) = first;" >> "%t.dir/main.co"
# RUN: echo "pub fn<int> selectLast(bool first, int last) { println(first); return 99; }" > "%t.dir/helpers.co"
# RUN: echo "pub fn<int> selectLast(int value) = value;" >> "%t.dir/helpers.co"
# RUN: echo "pub fn<int> selectLast(int first, int last) = pick(first, last);" >> "%t.dir/helpers.co"
# RUN: echo "fn<int> pick(int first, int last) = last;" >> "%t.dir/helpers.co"
