# Capacity can exceed length. An invalid index suppresses the right-hand side.
# RUN: echo "using cloth.Console : println; fn<int> trace(final int n) { println(n); return n; }" > "%t.co"
# RUN: echo "pub fn<int> main() { int[] values = [7]; values.reserve(64); values[trace(1)] = trace(99); return 42; }" >> "%t.co"
# RUN: %cloth --stdlib %stdlib --kind executable --src "%t.co" --emit object -o "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 1 --stderr-line "Cloth runtime error: array index out of bounds" 1 "%t.exe"

# The coordinate is checked again if the right-hand side replaces the array with a shorter one.
# RUN: echo "using cloth.Console : println; fn<int> trace(final int n) { println(n); return n; }" > "%t.co"
# RUN: echo "pub fn<int> main() { int[] values = [7, 42]; values[trace(1)] += (if (trace(2) == 2) { values = []; 2; } else 0); return 42; }" >> "%t.co"
# RUN: %cloth --stdlib %stdlib --kind executable --src "%t.co" --emit object -o "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 1 --stdout-line 2 --stderr-line "Cloth runtime error: array index out of bounds" 1 "%t.exe"

