# REQUIRES: x86 && (linux || win32)

# RUN: mkdir -p "%t.dir"
# RUN: %cloth --kind library --module-name Arithmetic --src "%S/Inputs/native-library/api.co" --emit-object "%t.dir/lib.o"
# RUN: %cloth --kind executable --extern "Arithmetic=%S/Inputs/native-library/api.co" --src "%S/Inputs/native-library/main.co" --emit-object "%t.dir/app.o"
# RUN: %cc "%t.dir/app.o" "%t.dir/lib.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"

# RUN: %llvm_readobj --symbols "%t.dir/lib.o" > "%t.lib.txt"
# RUN: %filecheck "%s" --check-prefixes=HELPER,HELPER-%host_os --input-file "%t.lib.txt"
# RUN: %filecheck "%s" --check-prefixes=EXPORT,EXPORT-%host_os --input-file "%t.lib.txt"
# RUN: %llvm_readobj --symbols "%t.dir/app.o" > "%t.app.txt"
# RUN: %filecheck "%s" --check-prefixes=IMPORT,IMPORT-%host_os --input-file "%t.app.txt"
# HELPER: Name: {{_?}}cloth.adjust
# HELPER-NOT: }
# HELPER-linux: Binding: Local
# HELPER: Section: .text (
# HELPER-win32-NOT: }
# HELPER-win32: StorageClass: Static
# EXPORT: Name: {{_?}}cloth_v1_
# EXPORT-NOT: }
# EXPORT-linux: Binding: Global
# EXPORT: Section: .text (
# EXPORT-win32-NOT: }
# EXPORT-win32: StorageClass: External
# IMPORT: Name: {{_?}}cloth_v1_
# IMPORT-NOT: }
# IMPORT-linux: Section: Undefined
# IMPORT-win32: Section: IMAGE_SYM_UNDEFINED

# Both spellings export the same functions and default-argument entry point.
# RUN: %cloth --kind library --module-name Arithmetic --src "%S/Inputs/native-library/grouped.co" --emit-object "%t.dir/grouped.o"
# RUN: %cc "%t.dir/app.o" "%t.dir/grouped.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"
# RUN: %cloth --kind executable --extern "Arithmetic=%S/Inputs/native-library/grouped.co" --src "%S/Inputs/native-library/main.co" --emit-object "%t.dir/grouped-app.o"
# RUN: %cc "%t.dir/grouped-app.o" "%t.dir/lib.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"
# RUN: %llvm_readobj --symbols "%t.dir/grouped.o" | %filecheck "%s" --check-prefixes=HELPER,HELPER-%host_os
# RUN: %llvm_readobj --symbols "%t.dir/lib.o" "%t.dir/grouped.o" | %filecheck "%s" --check-prefix=SAME --implicit-check-not=cloth_v1_
# SAME: File: {{.*}}lib.o
# SAME: Name: [[FIRST:_?cloth_v1_[A-Za-z0-9_.]+]]
# SAME: Name: [[SECOND:_?cloth_v1_[A-Za-z0-9_.]+]]
# SAME: Name: [[THIRD:_?cloth_v1_[A-Za-z0-9_.]+]]
# SAME: Name: [[FOURTH:_?cloth_v1_[A-Za-z0-9_.]+]]
# SAME: File: {{.*}}grouped.o
# SAME-DAG: Name: [[FIRST]]{{( |$)}}
# SAME-DAG: Name: [[SECOND]]{{( |$)}}
# SAME-DAG: Name: [[THIRD]]{{( |$)}}
# SAME-DAG: Name: [[FOURTH]]{{( |$)}}

# Reordering overloads and renaming parameters preserve the original consumer's ABI.
# RUN: echo "pub fn<int> pick(bool value) = 0;" > "%t.dir/reordered.co"
# RUN: echo "pub fn<int> pick(int input) = input - 33;" >> "%t.dir/reordered.co"
# RUN: echo "pub fn<int> seed(opt<int> value ?: 40) = value;" >> "%t.dir/reordered.co"
# RUN: %cloth --kind library --module-name Arithmetic --src "%t.dir/reordered.co" --emit-object "%t.dir/lib.o"
# RUN: %cc "%t.dir/app.o" "%t.dir/lib.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 7 "%t.exe"

