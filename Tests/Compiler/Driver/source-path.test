# RUN: echo "pub fn<bool> ready() = true;" > "%t/source files/helper.clib"
# RUN: echo "fn main() {}" > "%t/source files/main.txt"
# RUN: echo "pub fn<bool> ready() = true;" > "%t/source files/.hidden.part.CLIB"
# RUN: echo "fn main() {}" > "%t/source files/..co"
# RUN: cd "%t/source files" && %expect_exit --empty-stdout --empty-stderr 0 %cloth --src "-日本語 main.co"
# RUN: cd "%t/source files" && %expect_exit --empty-stdout --stderr-line "[C0010] Error: Could not open source file 'missing source.co': expected a regular file" 1 %cloth --src "missing source.co"
# RUN: %expect_exit --empty-stdout --empty-stderr 0 %cloth --src "%t/source files/helper.clib"
# RUN: %expect_exit --empty-stdout --empty-stderr 0 %cloth --src "%t/source files/.hidden.part.CLIB"
# RUN: cd "%t/source files" && %expect_exit --empty-stdout --stderr-line "[C0012] Error: Invalid source file name '..co' (expected a nonempty stem other than '.')" 1 %cloth --src "..co"
# RUN: %expect_exit --empty-stdout --stderr-line "[C0012] Error: Invalid source file name './' (expected a nonempty stem other than '.')" 1 %cloth --src "./"
# RUN: %expect_exit --empty-stdout 1 %cloth --src "%t/source files/main.txt" 2> "%t.err"
# RUN: %filecheck "%/s" --input-file "%t.err"

# CHECK: Unsupported extension for source file
# CHECK-SAME: main.txt
# CHECK-SAME: expected .co or .clib
