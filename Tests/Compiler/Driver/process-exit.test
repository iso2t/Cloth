# The status expression runs once. Exiting in a helper also stops its caller.
# RUN: echo "pub fn<int> main() { finish(); println(99); return 42 }" > "%t.co"
# RUN: echo "fn<void> finish() = exit(status())" >> "%t.co"
# RUN: echo "fn<unsigned int<97>> status() { println(3); return 18446744073709551879 }" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 3 --empty-stderr 263 "%t.exe"

