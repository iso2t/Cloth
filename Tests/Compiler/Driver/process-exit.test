# Evaluate each argument once in source order, then write the complete UTF-8 span.
# The percent sign is data, the message contains a literal LF, and its last byte is Z.
# RUN: %cloth --kind executable --src "%S/Inputs/process-exit-message.co" --target-bits 32 --emit-object "%t.32.o"
# RUN: %cloth --kind executable --src "%S/Inputs/process-exit-message.co" --target-bits 64 --emit-object "%t.64.o"
# RUN: %cloth --kind executable --src "%S/Inputs/process-exit-message.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %python -c "import os, sys; from pathlib import Path; Path(sys.argv[1]).write_bytes(('1' + os.linesep + '2' + os.linesep).encode('ascii') + bytes.fromhex('4100c3a9f09f9880250a5a'))" "%t.stdout"
# RUN: %expect_exit --stdout-file "%t.stdout" --empty-stderr 263 "%t.exe"

# RUN: echo 'pub fn<int> main() = exit(-2 -> int<8>, "")' > "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 0xfffffffe "%t.exe"

# A read-only file handle makes even a buffered write fail when the message is flushed.
# RUN: echo 'pub fn<int> main() = exit(7, "X")' > "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --stderr-line "Cloth runtime error: standard output write failed" 1 %python -c "import subprocess, sys; sys.exit(subprocess.run([sys.argv[2]], stdout=open(sys.argv[1], 'rb')).returncode)" "%t.co" "%t.exe"

# A user-defined exit is an ordinary call and its result reaches main.
# RUN: echo "pub fn<int> main() = exit(34)" > "%t.co"
# RUN: echo "fn<int> exit(int n) = n + 8" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"
