# RUN: echo "pub fn<int> main() { println(choose(false)); return choose(true) }" > "%t.co"
# RUN: echo "fn<int> choose(bool stop) = if (stop) exit(7) else 42" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 42 --empty-stderr 7 "%t.exe"

# The status expression runs once. Exiting in a helper also stops its caller.
# RUN: echo "pub fn<int> main() { finish(); println(99); return 42 }" > "%t.co"
# RUN: echo "fn<void> finish() = exit(status())" >> "%t.co"
# RUN: echo "fn<unsigned int<97>> status() { println(3); return 18446744073709551879 }" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 3 --empty-stderr 263 "%t.exe"

# RUN: echo "pub fn<int> main() = exit(-1 -> int<8>)" > "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 0xffffffff "%t.exe"

# RUN: echo "pub fn<int> main() = exit(first(), exit(0))" > "%t.co"
# RUN: echo "fn<int> first() { println(2); return 19 }" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 2 --empty-stderr 0 "%t.exe"

# A user-defined exit is an ordinary call and its result reaches main.
# RUN: echo "pub fn<int> main() = exit(34)" > "%t.co"
# RUN: echo "fn<int> exit(int n) = n + 8" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"
