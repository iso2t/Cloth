# An explicit import resolves the selected library implementation.
# RUN: echo 'pub fn<string?> input() = "library";' > "%t.lib/cloth/Console.co"
# RUN: echo 'using cloth.Console : input; pub fn<int> main() { return if (input() == "library") 42 else 1; }' > "%t.co"
