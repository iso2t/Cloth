# RUN: %cloth --emit assembly --kind executable --src "%t/src/answer.v1.co" -o "%t/custom assembly.o"
# RUN: %filecheck "%/s" --check-prefix=ASSEMBLY --input-file "%t/custom assembly.o"
# RUN: cd "%t/src" && %python -c "from pathlib import Path; assert list(Path('.').iterdir()) == [Path('answer.v1.co')]"

# With no destination, replace the source's final extension in its own directory.
# RUN: %cloth --src "%t/src/answer.v1.co" --kind executable --emit object
# RUN: %llvm_readobj --file-headers "%t/src/answer.v1.o" | %filecheck "%/s" --check-prefix=OBJECT
