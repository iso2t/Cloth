# RUN: %llvm_mc --filetype=obj "%t/src/answer.v1.s" -o "%t/assembled.o"
# RUN: %cc "%t/assembled.o" -o "%t/answer.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t/answer.exe"

# An output request without a kind defaults to a relocatable object.
# RUN: %cloth --kind executable -o "%t/default" --src "%t/src/answer.v1.co"
# RUN: %llvm_readobj --file-headers "%t/default" | %filecheck "%/s" --check-prefix=OBJECT

