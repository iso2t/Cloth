# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# REQUIRES: x86 && (linux || win32)
# DEFINE: %{cast_error} = Cloth runtime error: invalid float-to-integer cast (NaN or out of range)

# A failing cast evaluates its operand once and exits before the next statement.
# RUN: echo "using cloth.Console : println; pub fn<int> main() { int<8> n := sample() -> int<8>; println(99); return n -> int; }" > "%t.co"
# RUN: echo "fn<float> sample() { println(7); return 128.0; }" >> "%t.co"
# RUN: %cloth --stdlib %stdlib --kind executable --src "%t.co" --target-bits 32 --emit-object "%t.32.o"
# RUN: %cloth --stdlib %stdlib --kind executable --src "%t.co" --target-bits 64 --emit-object "%t.64.o"
# RUN: %cloth --stdlib %stdlib --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --stdout-line 7 --stderr-line "%{cast_error}" 1 "%t.exe"

# RUN: echo "pub fn<int> main() = narrow(-129.0) -> int;" > "%t.co"
# RUN: echo "fn<int<8>> narrow(float<16> n) = n -> int<8>;" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --stderr-line "%{cast_error}" 1 "%t.exe"

# RUN: echo "pub fn<int> main() = narrow(-1.0) -> int;" > "%t.co"
# RUN: echo "fn<unsigned int<12>> narrow(float<64> n) = n -> unsigned int<12>;" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --stderr-line "%{cast_error}" 1 "%t.exe"

# RUN: echo "pub fn<int> main() = unsignedCast(0.0) -> int;" > "%t.co"
# RUN: echo "fn<usize> unsignedCast(float zero) = (zero / zero) -> usize;" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --stderr-line "%{cast_error}" 1 "%t.exe"

# RUN: echo "pub fn<int> main() = negativeInfinity(0.0) -> int;" > "%t.co"
# RUN: echo "fn<int<1025>> negativeInfinity(float<64> zero) = (-1.0 / zero) -> int<1025>;" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --stderr-line "%{cast_error}" 1 "%t.exe"

# An invalid constant cast only fails if its branch executes.
# RUN: echo "fn<int> choose(bool take) = if (take) { (1.0 / 0.0) -> int; } else { 42; };" > "%t.choose"
# RUN: echo "pub fn<int> main() = choose(false);" > "%t.co"
# RUN: cat "%t.choose" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"
# RUN: echo "pub fn<int> main() = choose(true);" > "%t.co"
# RUN: cat "%t.choose" >> "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
# RUN: %expect_exit --empty-stdout --stderr-line "%{cast_error}" 1 "%t.exe"

# RUN: echo "pub fn<int> main() = (4096.0 -> unsigned int<12>) -> int;" > "%t.co"
# RUN: %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" %runtime -o "%t.exe"
