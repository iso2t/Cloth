# RUN: %expect_exit --empty-stderr 0 %cloth --help > "%t.help"
# RUN: %filecheck "%s" --check-prefix=HELP --input-file "%t.help"
# HELP: cloth [options] --src PATH
# HELP: Options
# HELP-DAG: --help Show this help.
# HELP-DAG: --version Print the compiler version.
# HELP-DAG: --print-target Print the target triple.
# HELP-DAG: --record-extern-interfaces
# HELP-DAG: --module-name <a library name>
# HELP-DAG: --extern <NAME=SOURCE>
# HELP-DAG: --kind <library or executable>
# HELP-DAG: --target-bits <32 or 64>
# HELP-DAG: --stdlib <a directory>
# HELP-DAG: -l Scan tokens and exit silently.
# HELP-DAG: -L Print the token table and exit.
# HELP-DAG: --src <a file path>
# HELP-DAG: --emit <object or assembly>
# HELP-DAG: -o <a file path>
# HELP-DAG: --output <a file path>
# HELP-DAG: --emit-object <a file path>
# RUN: %expect_exit --empty-stderr 0 %cloth --version > "%t.version"
# RUN: %filecheck "%s" --match-full-lines --check-prefix=VERSION --input-file "%t.version"
# VERSION: cloth {{[0-9]+\.[0-9]+\.[0-9]+([-+][[:alnum:].-]+)*}}
# VERSION-NOT: {{.+}}

