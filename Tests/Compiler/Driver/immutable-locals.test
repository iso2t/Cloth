# REQUIRES: x86 && (linux || win32)

# RUN: echo "pub fn<int> main () { int answer := 42; return answer; }" > "%t.co"
# RUN: %expect_exit --empty-stdout --empty-stderr 0 %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 42 "%t.exe"

# RUN: echo "pub fn<int> main () { def answer := 7; return answer; }" > "%t.co"
# RUN: %expect_exit --empty-stdout --empty-stderr 0 %cloth --kind executable --src "%t.co" --emit-object "%t.o"
# RUN: %cc "%t.o" -o "%t.exe"
# RUN: %expect_exit --empty-stdout --empty-stderr 7 "%t.exe"

# RUN: echo "pub fn<int> main () { int answer := 42; answer = 7; return answer; }" > "%t.co"
# RUN: %expect_exit --empty-stdout 1 %cloth --kind executable --src "%t.co" --emit-object "%t.o" 2> "%t.err"
# RUN: %filecheck "%/s" --input-file "%t.err"
# CHECK: [C3002] Error: Cannot reassign immutable binding 'answer'
