using library: Catalog, Query, Reader, keep
typedef<class> Local {}
fn<Local> privateUse(Local item) = keep(item)
fn<Catalog.Entry> nested(Catalog.Entry item) = keep(item)
fn<int> read(Query item, bool seed) = item.read()
fn<int> amount(Reader item, bool seed) = item::amount()
