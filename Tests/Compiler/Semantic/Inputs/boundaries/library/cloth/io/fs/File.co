pub typedef<enum> FileError { InvalidPath, NotFound, PermissionDenied, OpenFailed, AlreadyOpen, NotOpen, ReadFailed; }
pub final typedef<class> File {
    pub mt<FileError?> open(string path) = intrinsic "io.file.open";
    pub mt<unsigned int<8>[]?, FileError?> read(usize limit) = intrinsic "io.file.read";
}
