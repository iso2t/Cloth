typedef<struct> Slot<T> { pub T value; }
pub typedef<struct> Snapshot<T> {
    Slot<T>[] slots;
    pub mt<Snapshot<T>> copyOf(T[] values) {
        Snapshot<T> result = { [] };
        usize index = 0;
        while (index < values::size) {
            result.slots.append({ values[index] });
            index += 1;
        }
        return result;
    }
}
