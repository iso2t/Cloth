typedef<struct> Loop<T> { Other<T> value }
typedef<struct> Other<T> { Loop<T>? value }

// RUN: %expect_exit --empty-stdout 1 %cloth --target-bits 32 --src "%/s" 2> "%t.expected"
// RUN: %filecheck "%/s" --input-file "%t.expected"
// RUN: %expect_exit --empty-stdout 1 %cloth --target-bits 32 --src "%/s" 2> "%t.err"
// RUN: diff -u "%t.expected" "%t.err"
// RUN: %expect_exit --empty-stdout 1 %cloth --target-bits 64 --src "%/s" 2> "%t.err"
// RUN: diff -u "%t.expected" "%t.err"
// RUN: %expect_exit --empty-stdout 1 %cloth --target-bits 64 --src "%/s" 2> "%t.err"
// RUN: diff -u "%t.expected" "%t.err"
// CHECK: [C3080] Error: Recursive storage in struct 'Loop'
// CHECK: recursive-storage.co:4:37
// CHECK: 3 | typedef<struct> Loop<T> { Other<T> value }
// CHECK: declared here
// CHECK: 4 | typedef<struct> Other<T> { Loop<T>? value }
// CHECK: Recursive storage in struct 'Loop'
