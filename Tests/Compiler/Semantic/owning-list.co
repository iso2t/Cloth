using cloth.collections.OwningList: OwningList;
using cloth.collections.Snapshot: Snapshot, emptySnapshot;

typedef<class> Item(def<int> value) {
    pub Item() : (1) {}
    pub mt<int> read() = value;
}

fn<Item> readAt(OwningList<Item> list, usize index) = list[index];

fn main() {
    def list = OwningList<Item>::new;
    list.append(Item::new);
    list.append(Item::new);
    def first = readAt(list, 0);
    Snapshot<int> values = emptySnapshot<int>();
    for (def held <- list) values.append(held.read());
    list.removeAt(0);
    first::delete;
    list::delete;
}

// RUN: %expect_exit --empty-stdout --empty-stderr 0 %cloth --kind executable --stdlib "%/S/../../../Stdlib" --src "%/s"
