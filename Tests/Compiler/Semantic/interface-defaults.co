typedef<interface> Left { pub mt<int> choose() = default (1) }
typedef<interface> Right { pub mt<int> choose() = default (2) }
typedef<class> Both : Left, Right {}

// RUN: %expect_exit --empty-stdout 1 %cloth --src "%/s" 2> "%t.err"
// RUN: %filecheck "%/s" --input-file "%t.err"
// CHECK: [C3124] Error: Conflicting interface defaults for 'choose'
// CHECK: interface-defaults.co:5:16
// CHECK: first declaration
// CHECK: other declaration
