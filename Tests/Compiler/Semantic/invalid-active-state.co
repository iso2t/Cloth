typedef<class> Player {
    pub state<int> ::read(int value);
    pub default state<void> Ready { mt<int> read(int value) = value; }
    pub state<void> Stopped {}
}
fn<int> test(Player player) {
    player -> Stopped;
    return player::read(if (true) { player -> Stopped; 1; } else { 2; });
}

// RUN: %expect_exit --empty-stdout 1 %cloth --src "%/s" 2> "%t.err"
// RUN: %filecheck "%/s" --input-file "%t.err"
// CHECK: [C3130] Error: State 'Stopped' does not implement 'read'
// CHECK: invalid-active-state.co:10:20
// CHECK:  6 |     pub state<void> Stopped {}
// CHECK: 10 |     return player::read
