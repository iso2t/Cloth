fn<int> read() = choose(true)
fn<int> choose(int value) = value
fn<bool> choose(bool value) = value

// RUN: %expect_exit --empty-stdout 1 %cloth --src "%/s" 2> "%t.err"
// RUN: %filecheck "%/s" --input-file "%t.err"
// CHECK: [C3032] Error: Expected int, found bool
// CHECK: body-overload.co:3:18
