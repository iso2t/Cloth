typedef<struct> Cursor {
    pub int position;
    pub operator ++() { position++; }
    pub operator ..(int end) -> int[] = [position, end];
    pub operator ==(Cursor other) = position == other.position;
    pub operator ||(bool flag, self) = flag;
}

fn main() {
    Cursor cursor = { 0 };
    cursor++;
    for (def value <- cursor .. 4) { int element = value; }
    bool same = [cursor] != [cursor, cursor];
    bool flag = false || cursor;
}

// RUN: %expect_exit --empty-stdout --empty-stderr 0 %cloth --kind executable --src "%/s"
